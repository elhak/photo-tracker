[Unit]
Description=Remove expired Boss Laundry photos
After=network-online.target

[Service]
Type=oneshot
User=photo-tracker
Group=photo-tracker
WorkingDirectory=/opt/photo-tracker
EnvironmentFile=/etc/photo-tracker.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/photo-tracker/.venv/bin/python manage.py cleanup_photos
TimeoutStartSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/photo-tracker
