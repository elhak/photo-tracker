tracker.example.com {
    encode zstd gzip
    handle_path /static/* {
        root * /opt/photo-tracker/staticfiles
        file_server
        header Cache-Control "public, max-age=3600"
    }
    handle {
        request_body {
            max_size 32KB
        }
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Real-IP {remote_host}
        }
    }
}
