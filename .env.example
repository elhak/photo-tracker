DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=tracker.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://tracker.example.com
# Enable only after confirming every subdomain also uses HTTPS.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
# Enable only when opting this domain into browser HSTS preloading.
DJANGO_HSTS_PRELOAD=0
DATABASE_PATH=/var/lib/photo-tracker/db.sqlite3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional: full HTTPS endpoint. Backblaze B2 is detected automatically and uses PUT uploads.
S3_ENDPOINT_URL=
